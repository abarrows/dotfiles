  "css.validate": false,
  "cssModules.pathAlias": {},
  "debug.allowBreakpointsEverywhere": false,
  "debug.console.fontSize": 16,
  "debug.javascript.terminalOptions": {
    "skipFiles": [
      "**/node_modules/**",
      "<node_internals>/**",
      "storybook-static/**",
    ],
  },
  "debug.openExplorerOnEnd": false,
  "debug.terminal.clearBeforeReusing": true,
  "debug.toolBarLocation": "docked",
  "dev.containers.logLevel": "trace",
  "diffEditor.codeLens": true,
  "diffEditor.experimental.showMoves": false,
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.useInlineViewWhenSpaceIsLimited": false,
  "docker.images.sortBy": "CreatedTime",
  "dotfiles.installCommand": "install",
  "editor.accessibilitySupport": "off",
  "editor.autoClosingBrackets": "always",
  "editor.bracketPairColorization.enabled": true,
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
  },
  "editor.pasteAs.preferences": ["uri.path.absolute", "text.updateImports"],
  "editor.cursorBlinking": "expand",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorStyle": "line",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.emptySelectionClipboard": false,
  "editor.fastScrollSensitivity": 10,
  "editor.find.autoFindInSelection": "never",
  "editor.fontFamily": "monaco",
  "editor.fontLigatures": true,
  "editor.fontSize": 12,
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.formatOnType": false,
  "editor.guides.bracketPairs": true,
  "editor.guides.bracketPairsHorizontal": true,
  "editor.guides.highlightActiveIndentation": true,
  "editor.guides.indentation": true,
  "editor.hover.delay": 200,
  "editor.inlineCompletionsAccessibilityVerbose": true,
  "editor.largeFileOptimizations": false,
  "editor.minimap.enabled": false,
  "editor.quickSuggestions": {
    "comments": "off",
    "other": "on",
    "strings": "off",
  },
  "editor.scrollBeyondLastLine": true,
  "editor.suggestSelection": "first",
  "editor.tabCompletion": "onlySnippets",
  "editor.tabSize": 2,
  "editor.tokenColorCustomizations": {
    "[*Light*]": {
      "textMateRules": [
        {
          "scope": "ref.matchtext",
          "settings": {
            "foreground": "#000"
          }
        }
      ]
    },
    "[*Dark*]": {
      "textMateRules": [
        {
          "scope": "ref.matchtext",
          "settings": {
            "foreground": "#fff"
          }
        }
      ]
    },
    "textMateRules": []
  },
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "editor.unicodeHighlight.invisibleCharacters": false,
  "editor.wordSeparators": "`~!@#$%^&*()-=+[{]}\\|;:'\",.<>/?",
  "editor.wordWrap": "bounded",
  "editor.snippetSuggestions": "bottom",
  "emmet.showSuggestionsAsSnippets": false,
  "emmet.includeLanguages": {
    "javascript": "javascriptreact",
    "sass": "css",
    "scss": "css",
    "typescript": "typescriptreact",
  },
  "emmet.showAbbreviationSuggestions": false,
  "emmet.triggerExpansionOnTab": true,
  "eslint.lintTask.enable": true,
  "eslint.run": "onSave",
  "eslint.useESLintClass": false,
  "eslint.validate": [
    "html",
    "javascript",
    "javascriptreact",
    "json",
    "typescript",
    "typescriptreact",
  ],
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmPasteNative": false,
  "extensions.autoCheckUpdates": true,
  "extensions.closeExtensionDetailsOnViewChange": true,
  "extensions.ignoreRecommendations": true,
  "files.associations": {
    ".mjmlconfig": "json",
    "*ci.yaml": "azure-pipelines",
    "*.base": "ruby",
    "*.devops": "ruby",
    "*.js.erb": "js",
    "*.zsh": "shellscript",
    ".aliases.zsh": "shellscript",
    ".browserslistrc": "dockerfile",
    ".env.*": "dotenv",
    ".env.example": "dotenv",
    ".zshrc": "shellscript",
    ".env*": "dotenv"
  },
  "files.autoSave": "off",
  "files.defaultLanguage": "${activeEditorLanguage}",
  "files.exclude": {
    "**/.history": true,
    "**/.idea": true,
    "**/log/**.log": true,
    "**/public/assets**": true,
    "**/public/packs**": true,
    "**/var/folders/**": true,
  },
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.hg/store/**": true,
    "**/.next/**": true,
    "**/node_modules/*/**": true,
    "**/dist/**": true,
    "**/.git/**": true,
    "**/storybook-static/**": true,
  },
  "gistpad.playgrounds.showConsole": true,
  "gistpad.playgrounds.stylesheetLanguage": "scss",
  "git.autofetch": true,
  "git.autoStash": true,
  "git.confirmSync": false,
  "git.enableCommitSigning": true,
  "git.enableSmartCommit": true,
  "git.ignoreRebaseWarning": true,
  "git.inputValidationLength": 200,
  "git.inputValidationSubjectLength": null,
